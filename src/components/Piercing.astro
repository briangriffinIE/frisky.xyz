---
const services = [
  {
    name: 'Ear Piercings',
    description: 'From lobes to industrials, including daith, tragus, and conch piercings.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>`
  },
  {
    name: 'Facial Piercings',
    description: 'Nostril, septum, lip, and eyebrow piercings with custom jewelry options.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
  },
  {
    name: 'Body Piercings',
    description: 'Navel, nipple, and surface piercings with focus on proper placement and healing.',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`
  }
];

const certifications = [
  'APP Member',
  'Bloodborne Pathogens Certified',
  'First Aid & CPR Certified'
];

const tools = [
  'Implant Grade Titanium',
  'Sterile Needles',
  'Autoclave Sterilization',
  'Single-Use Equipment'
];
---

<section class="py-20 bg-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="section-title text-center">Piercing Work</h2>
    
    <div class="prose prose-invert max-w-none text-center mb-12">
      <p class="text-lg">
        From lobes to industrials, Brian's approach to piercing is grounded in safety, precision, and artistry.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {services.map(service => (
        <div class="card">
          <div class="text-accent mb-4">
            <Fragment set:html={service.icon} />
          </div>
          <h3 class="text-xl font-serif font-bold mb-2">
            {service.name}
          </h3>
          <p class="text-text-muted">
            {service.description}
          </p>
        </div>
      ))}
    </div>

    <!-- Certifications & Tools -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h3 class="text-2xl font-serif font-bold mb-4">Certifications</h3>
        <ul class="space-y-2">
          {certifications.map(cert => (
            <li class="flex items-center text-text-muted">
              <svg class="w-5 h-5 text-accent mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              {cert}
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-2xl font-serif font-bold mb-4">Tools & Materials</h3>
        <ul class="space-y-2">
          {tools.map(tool => (
            <li class="flex items-center text-text-muted">
              <svg class="w-5 h-5 text-accent mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              {tool}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="text-center mt-16">
      <a href="/contact" class="btn-primary">
        Book a Consultation
      </a>
    </div>
  </div>
</section> 